---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { navigation, studio } from '../lib/studio';
---
<dialog id="search-dialog" class="panel" aria-labelledby="search-dialog-title">
  <form method="dialog" class="panel-close"><button class="icon-button round-button" type="submit" aria-label="Close search"><Icon name="close" /></button></form>
  <span class="eyebrow">Find it fast</span>
  <h2 id="search-dialog-title">Search Vision Hub.</h2>
  <label for="site-search" class="sr-only">Search frames and services</label>
  <div class="search-field"><Icon name="search" /><input type="search" id="site-search" placeholder="Try ‘rimless’ or ‘eye test’" autocomplete="off" autofocus /></div>
  <p class="sr-only" id="search-status" role="status"></p>
  <div class="panel-results" id="search-results"></div>
</dialog>

<dialog id="saved-dialog" class="panel" aria-labelledby="saved-dialog-title">
  <form method="dialog" class="panel-close"><button class="icon-button round-button" type="submit" aria-label="Close saved frames" autofocus><Icon name="close" /></button></form>
  <span class="eyebrow">Your shortlist</span>
  <h2 id="saved-dialog-title">Saved frames.</h2>
  <p class="panel-lead">Keep track of the styles you’d like to try on.</p>
  <div class="panel-results" id="saved-results"></div>
</dialog>

<dialog id="menu-dialog" class="panel menu-panel" aria-label="Site menu">
  <form method="dialog" class="panel-close"><button class="icon-button round-button" type="submit" aria-label="Close menu" autofocus><Icon name="close" /></button></form>
  <Brand />
  <nav aria-label="Mobile navigation">
    {navigation.map((item) => <a href={item.href}>{item.label} <Icon name="right" /></a>)}
  </nav>
  <div class="menu-contact">
    <a class="button button-primary" href="/#eye-care">Book an eye test <Icon name="diagonal" size={18} /></a>
    <a class="text-link" href={studio.instagramProfile} target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={18} /> {studio.handle}</a>
  </div>
</dialog>
<div class="sr-only" id="saved-status" role="status"></div>
