---
import '@fontsource-variable/manrope';
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '../styles/site.css';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import KotaLabsCredit from '../components/KotaLabsCredit.astro';
import Reels from '../components/Reels.astro';
import SiteDialogs from '../components/SiteDialogs.astro';
import { categories, filters, fitGuide, frames, navigation, reviews, studio } from '../lib/studio';

const title = 'Vision Hub Kota | Eyewear & Eye Tests in Talwandi';
const description = 'Find eyeglasses, sunglasses, contact lenses and in-store eye tests at Vision Hub Kota. Visit our optical studio on Opera Road in Talwandi, Kota.';
const kotaLabsWebsite = 'https://www.kotalabs.in/';
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'Optician',
  name: studio.name,
  description,
  telephone: studio.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: studio.address[0],
    addressLocality: 'Kota',
    addressRegion: 'Rajasthan',
    postalCode: '324005',
    addressCountry: 'IN',
  },
  hasMap: studio.directions,
  sameAs: ['https://www.instagram.com/visionhub.kota/'],
};
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfaf6" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <noscript><style>.requires-js { display: none !important; }</style></noscript>
  </head>
  <body id="top">
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="location-bar">
      <a href={studio.directions} target="_blank" rel="noopener noreferrer">
        <Icon name="pin" size={15} /> <span>Talwandi, Kota</span><span class="location-divider" aria-hidden="true"></span><span class="location-directions">Get directions <Icon name="diagonal" size={13} /></span>
      </a>
    </div>
    <header class="site-header">
      <div class="shell header-inner">
        <Brand />
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <button class="icon-button requires-js" type="button" data-dialog-open="search-dialog" aria-label="Search" aria-haspopup="dialog"><Icon name="search" size={22} /></button>
          <button class="icon-button header-saved requires-js" type="button" data-dialog-open="saved-dialog" aria-label="Saved frames" aria-haspopup="dialog"><Icon name="heart" size={22} /><span class="saved-count" data-saved-count aria-hidden="true" hidden></span></button>
          <a class="button button-outline nav-cta" href="#eye-care">Book an eye test <Icon name="diagonal" size={15} /></a>
          <button class="icon-button mobile-menu requires-js" type="button" data-dialog-open="menu-dialog" aria-label="Open menu" aria-haspopup="dialog"><Icon name="menu" size={22} /></button>
        </div>
      </div>
    </header>

    <main id="content" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <span class="eyebrow">Kota’s optical studio</span>
            <h1 id="hero-title">See well.<br /><em>Live beautifully.</em></h1>
            <p>Eyewear with character and eye care close to home. Find your next pair at our optical studio in Talwandi, Kota.</p>
            <div class="button-row hero-actions">
              <a class="button button-primary" href="#eyewear">Explore eyewear <Icon name="right" size={19} /></a>
              <a class="button button-outline" href="#visit">Visit the studio <Icon name="diagonal" size={18} /></a>
            </div>
          </div>
          <figure class="hero-visual">
            <img src="/images/hero.webp" srcset="/images/hero-small.webp 640w, /images/hero.webp 1200w" sizes="(max-width: 720px) 92vw, (max-width: 1400px) 50vw, 670px" width="1200" height="896" alt="Woman in clear tortoiseshell eyeglasses and an ivory blazer, lit by afternoon sun" fetchpriority="high" />
            <figcaption class="hero-caption"><span>01</span> The Vision Edit</figcaption>
            <span class="photo-corner" aria-hidden="true"></span>
          </figure>
        </div>
      </section>

      <div class="studio-facts">
        <div class="shell facts-grid">
          <a class="fact" href={studio.ratingSource} target="_blank" rel="noopener noreferrer">
            <span class="fact-icon"><Icon name="star" size={21} /></span><span><strong>{studio.rating} out of 5</strong><small>Rated by customers on Justdial</small></span>
          </a>
          <a class="fact" href="#eye-care">
            <span class="fact-icon"><Icon name="glasses" size={23} /></span><span><strong>In-store eye tests</strong><small>Get help with your prescription</small></span>
          </a>
          <a class="fact" href="#visit">
            <span class="fact-icon"><Icon name="pin" size={22} /></span><span><strong>Visit us in Talwandi</strong><small>3-F-27, Opera Road, Kota</small></span>
          </a>
        </div>
      </div>

      <section class="section shell collection" id="eyewear" aria-labelledby="collection-title">
        <div class="section-heading">
          <div>
            <span class="eyebrow">The collection</span>
            <h2 id="collection-title">Find your kind <em>of frame.</em></h2>
          </div>
          <a class="text-link" href="#frame-edit" data-set-filter="all">Explore the frame edit <Icon name="diagonal" size={18} /></a>
        </div>
        <div class="category-grid">
          {categories.map((category, index) => (
            <a class="category-card" href={category.href} data-set-filter={category.filter}>
              <div class="category-image">
                <img src={category.image} alt={category.alt} width="940" height="702" loading="lazy" decoding="async" />
                <span class="category-index" aria-hidden="true">0{index + 1}</span>
              </div>
              <div class="category-body">
                <div><h3>{category.name}</h3><p>{category.description}</p></div>
                <span class="category-arrow"><Icon name="right" size={21} /></span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="section frame-section" id="frame-edit" aria-labelledby="frame-edit-title">
        <div class="shell">
          <div class="section-heading frame-heading">
            <div>
              <span class="eyebrow">The frame edit</span>
              <h2 id="frame-edit-title">Four looks to <em>try on.</em></h2>
              <p>Get inspired for your next visit, from slim metal rims to bold acetate.</p>
            </div>
            <div class="segmented requires-js" role="group" aria-label="Filter frames">
              {filters.map((filter) => <button type="button" data-filter={filter.key} aria-pressed={filter.key === 'all' ? 'true' : 'false'} aria-controls="frame-grid">{filter.label}</button>)}
            </div>
          </div>
          <div class="frame-grid" id="frame-grid">
            {frames.map((frame) => (
              <article class="frame-card" data-frame-card={frame.category}>
                <div class="frame-image">
                  <img src={frame.image} width="740" height="553" loading="lazy" decoding="async" alt={frame.alt} />
                  <button type="button" class="icon-button frame-save requires-js" data-save-frame={frame.id} aria-label={`Save ${frame.name}`} aria-pressed="false"><Icon name="heart" size={20} /></button>
                </div>
                <div class="frame-body">
                  <span class="micro">{frame.category}</span>
                  <h3>{frame.name}</h3>
                  <p>{frame.shape} · {frame.material}</p>
                  <span class="frame-finish"><i style={`--swatch: ${frame.tone}`} aria-hidden="true"></i>{frame.finish}</span>
                  <button type="button" class="frame-open requires-js" data-open-frame={frame.id} aria-label={`View ${frame.name}`} aria-haspopup="dialog"><Icon name="diagonal" size={19} /></button>
                </div>
              </article>
            ))}
          </div>
          <div class="frame-note">
            <p class="fine-print">Styles shown for inspiration. Ask the studio about current stock and prices.</p>
            <a class="text-link" href="#visit">Try frames in store <Icon name="right" size={18} /></a>
          </div>
          <p class="sr-only" id="frame-status" role="status"></p>
        </div>
      </section>

      <section class="section shell care-section" id="eye-care" aria-labelledby="care-title">
        <div class="care-grid">
          <figure class="care-visual">
            <img src="/images/eye-test.webp" width="940" height="702" loading="lazy" decoding="async" alt="Illustration of an optometrist adjusting equipment during a vision test" />
            <figcaption class="image-caption"><Icon name="mark" size={22} /> Eye care, close to home</figcaption>
          </figure>
          <div class="care-copy">
            <span class="eyebrow">In-store eye care</span>
            <h2 id="care-title">Clear vision<br /><em>starts here.</em></h2>
            <p>If your glasses no longer feel quite right, call the Talwandi studio about an eye test and help choosing lenses.</p>
            <div class="button-row">
              <a class="button button-primary" href={studio.phoneHref}><Icon name="phone" size={18} /> Call to book</a>
              <a class="text-link" href="#visit">Plan your visit <Icon name="diagonal" size={18} /></a>
            </div>
            <div class="care-faq">
              <details>
                <summary>What should I bring? <Icon name="down" size={17} /></summary>
                <p>Bring your current glasses or contact lens details, your last prescription if you have it, and any questions about how you use your glasses day to day.</p>
              </details>
              <details>
                <summary>Can I ask about contact lenses? <Icon name="down" size={17} /></summary>
                <p>Yes. Call to discuss contact lenses or other lens options, including progressives, and check availability before you visit.</p>
              </details>
            </div>
          </div>
        </div>
      </section>

      <section class="shell fit-section" id="fit-guide" aria-labelledby="fit-title">
        <div class="fit-intro">
          <span class="eyebrow">The fit guide</span>
          <h2 id="fit-title">A fit that feels <em>like you.</em></h2>
          <p>Start with your face shape, then try a few pairs. How the frame feels matters more than any rule.</p>
        </div>
        <div class="fit-card">
          <div class="segmented requires-js" role="group" aria-label="Choose a face shape">
            {fitGuide.map((tip, index) => <button type="button" data-fit={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls="fit-tips">{tip.label}</button>)}
          </div>
          <div id="fit-tips" class="fit-tips" aria-live="polite">
            {fitGuide.map((tip, index) => (
              <div class="fit-tip" data-fit-tip={index} hidden={index !== 0}>
                <span class="fit-icon"><Icon name={tip.icon} size={35} /></span>
                <div><h3>{tip.heading}</h3><p>{tip.description}</p></div>
              </div>
            ))}
          </div>
          <a class="text-link" href="#frame-edit" data-set-filter="eyeglasses">Explore eyeglasses <Icon name="right" size={18} /></a>
        </div>
      </section>

      <section class="review-section" id="reviews" aria-labelledby="reviews-title">
        <div class="shell review-grid">
          <div class="reviews-intro">
            <span class="eyebrow">Kind words from Kota</span>
            <h2 id="reviews-title">What customers <em>say.</em></h2>
            <a class="review-rating" href={studio.ratingSource} target="_blank" rel="noopener noreferrer">
              <Icon name="star" size={19} /> <span><strong>{studio.rating}/5</strong> on Justdial</span> <Icon name="diagonal" size={16} />
            </a>
          </div>
          <div class="review-card" data-review-carousel>
            <span class="quote-mark" aria-hidden="true">“</span>
            <div aria-live="polite">
              {reviews.map((review, index) => (
                <figure class="review-quote" data-review={index} hidden={index !== 0}>
                  <blockquote>{review.quote}</blockquote>
                  <figcaption>{review.author} <span>·</span> <a href={studio.reviewSource} target="_blank" rel="noopener noreferrer">Review excerpt via Yappe</a></figcaption>
                </figure>
              ))}
            </div>
            <div class="review-nav requires-js" role="group" aria-label="Review navigation">
              <span class="micro" data-review-counter>01 / 0{reviews.length}</span>
              <button class="icon-button round-button" type="button" data-review-step="-1" aria-label="Previous review"><Icon name="left" size={18} /></button>
              <button class="icon-button round-button" type="button" data-review-step="1" aria-label="Next review"><Icon name="right" size={18} /></button>
            </div>
          </div>
        </div>
      </section>

      <section class="section shell visit-grid" id="visit" aria-labelledby="visit-title">
        <div class="visit-copy">
          <span class="eyebrow">Come say hello</span>
          <h2 id="visit-title">See you <em>in Kota.</em></h2>
          <p>Try on a few pairs, bring your prescription, or ask us to help you find a better fit.</p>
          <div class="visit-details">
            <address><Icon name="pin" size={22} /><span>{studio.address[0]}<br />{studio.address[1]}</span></address>
            <p><Icon name="clock" size={21} /><span>Call for today’s hours and eye-test availability.</span></p>
          </div>
          <div class="button-row">
            <a class="button button-primary" href={studio.directions} target="_blank" rel="noopener noreferrer">Get directions <Icon name="diagonal" size={17} /></a>
            <a class="button button-outline" href={studio.phoneHref}><Icon name="phone" size={18} /> {studio.phone}</a>
          </div>
        </div>
        <a class="map" href={studio.directions} target="_blank" rel="noopener noreferrer">
          <img src="/images/talwandi-map.svg" width="640" height="415" loading="lazy" alt="" />
          <span class="map-brand"><Icon name="mark" size={30} /><span>Vision Hub<small>Talwandi, Kota</small></span></span>
          <span class="map-caption">Area illustration · not to scale</span>
          <span class="map-open"><Icon name="diagonal" size={21} /></span>
          <span class="sr-only">Get directions on Google Maps</span>
        </a>
      </section>

      <Reels />
    </main>

    <footer class="site-footer">
      <div class="shell footer-main">
        <div class="footer-brand"><Brand /><p>Eyewear and eye care in Talwandi, Kota.</p></div>
        <nav class="footer-links" aria-label="Footer navigation">
          <p class="micro">Explore</p>
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="footer-links footer-visit">
          <p class="micro">Visit the studio</p>
          <a href={studio.directions} target="_blank" rel="noopener noreferrer">{studio.address[0]}<br />{studio.address[1]}</a>
          <a href={studio.phoneHref}>{studio.phone}</a>
        </div>
        <div class="footer-links footer-social">
          <p class="micro">Follow along</p>
          <a href={studio.instagram} target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={19} /> {studio.handle} <Icon name="diagonal" size={15} /></a>
        </div>
      </div>
      <KotaLabsCredit href={kotaLabsWebsite} />
      <div class="shell footer-bottom">
        <p>© {new Date().getFullYear()} Vision Hub Kota</p>
        <div class="footer-bottom-links">
          <a class="footer-credit-link" href={kotaLabsWebsite} target="_blank" rel="noopener noreferrer">Crafted by KotaLabs <Icon name="diagonal" size={14} /><span class="sr-only"> (opens in a new tab)</span></a>
          <a href="#top">Back to top <Icon name="up" size={16} /></a>
        </div>
      </div>
    </footer>

    <SiteDialogs />
    <script src="../lib/site.ts"></script>
  </body>
</html>
